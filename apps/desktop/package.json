{
  "name": "@dekzer/desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Dekzer desktop shell.",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache . --max-warnings=0",
    "clean": "tsx tooling/clean.mts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web && pnpm run typecheck:tooling",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:unit:watch": "vitest --config vitest.config.ts tests/unit",
    "test:integration": "vitest run --config vitest.config.ts tests/integration",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run lint",
    "storage:status": "tsx tooling/storage.mts status",
    "storage:reset": "tsx tooling/storage.mts reset",
    "storage:doctor": "tsx tooling/storage.mts doctor",
    "start:built": "electron-vite preview --ignoreConfigWarning",
    "dev": "electron-vite dev --ignoreConfigWarning",
    "dev:fresh": "pnpm run storage:reset -- --confirm-delete && pnpm run dev",
    "build": "pnpm run clean && pnpm run typecheck && electron-vite build --ignoreConfigWarning",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux"
  },
  "dependencies": {
    "@dekzer/library-boundary-client": "workspace:*",
    "@dekzer/library-boundary-stdio-transport": "workspace:*",
    "@electron-toolkit/utils": "^4.0.0",
    "@lucide/vue": "^1.16.0",
    "reka-ui": "^2.9.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.7",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6"
  }
}
