{
  "name": "@dekzer/root",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "engines": {
    "node": ">=25.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "install:workspace": "pnpm install",
    "dev:desktop": "pnpm --filter @dekzer/desktop run dev",
    "typecheck": "pnpm --filter @dekzer/desktop run typecheck",
    "check": "pnpm run typecheck && pnpm run fmt:rust && pnpm run lint:rust && pnpm run test:rust",
    "build": "pnpm run build:desktop",
    "build:desktop": "pnpm --filter @dekzer/desktop run build",
    "start:desktop": "pnpm --filter @dekzer/desktop run start:built",
    "test": "pnpm run test:rust",
    "test:rust": "cargo test --workspace",
    "fmt:rust": "cargo fmt --all --check",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  }
}
